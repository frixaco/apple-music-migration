# Apple Music: MusicKit signing key
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_MEDIA_ID=
# Either the key file (local) or its PEM contents (hosted, e.g. Railway)
APPLE_PRIVATE_KEY_PATH=secrets/AuthKey_XXXXXXXXXX.p8
APPLE_PRIVATE_KEY=

# Web app
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
DATABASE_URL=postgres://localhost:5432/migrator
# Google OAuth "Web application" client (sign-in and YouTube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
