{
  "name": "apple-music-migration",
  "type": "module",
  "private": true,
  "scripts": {
    "accept:deep-review-upgrades": "bun run src/accept-deep-review-upgrades.ts",
    "accept:score-1-review-upgrades": "bun run src/accept-score-1-review-upgrades.ts",
    "apply:manual-overrides": "bun run src/apply-manual-overrides.ts",
    "auth:user-token": "bun run src/start-user-token-auth.ts",
    "auth:youtube": "bun run src/auth-youtube.ts",
    "build": "vite build",
    "check": "bun run src/check-youtube-manifest.ts",
    "compare:youtube-latest": "bun run src/compare-latest-youtube-playlist.ts",
    "copy:favorites-to-all": "bun run src/copy-favorites-to-all.ts",
    "count:favorites": "bun run src/count-favorite-songs.ts",
    "count:playlist": "bun run src/count-playlist.ts",
    "create:favorites-copy": "bun run src/create-favorites-copy-playlist.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "deep-review:score-1": "bun run src/deep-review-score-1.ts",
    "deep-review:score-2-4": "bun run src/deep-review-score-2-4.ts",
    "dev": "vite dev --port 3000",
    "empty:favorites": "bun run src/empty-favorite-songs.ts",
    "export:non-added-simple": "bun run src/export-non-added-simple.ts",
    "export:review-set": "bun run src/export-review-set.ts",
    "export:youtube-non-added": "bun run src/export-youtube-non-added-playlist.ts",
    "fetch:youtube-non-added": "bun run src/fetch-youtube-non-added-playlist.ts",
    "format": "prettier --write src/components src/routes src/functions src/server src/db src/hooks src/integrations && eslint --fix",
    "generate-routes": "tsr generate",
    "generate:developer-token": "bun run src/generate-developer-token.ts",
    "lint": "eslint",
    "manual:add-song": "bun run src/manual-add-song.ts",
    "manual:init": "bun run src/init-manual-review.ts",
    "manual:record": "bun run src/manual-record.ts",
    "manual:search": "bun run src/manual-search.ts",
    "manual:summary": "bun run src/manual-progress-summary.ts",
    "score:youtube": "bun run src/score-youtube-apple-matches.ts",
    "score:youtube:low": "bun run src/score-youtube-apple-matches.ts --only-max-score=3",
    "start": "node .output/server/index.mjs",
    "test:developer-token": "bun run src/test-developer-token.ts",
    "typecheck": "tsc --noEmit",
    "youtube:create-non-added-playlist": "bun run src/create-youtube-non-added-playlist.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "^1.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "latest",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "railway": "^3.16.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
